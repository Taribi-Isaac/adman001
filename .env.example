# ADMAN environment example
# Copy to .env and set local values. Never commit real secrets.
#
# Environment roles:
#   local    — developer machine (APP_DEBUG=true OK)
#   staging  — pre-production; use separate credentials; prefer sandbox/disabled outbound
#   production — APP_DEBUG=false, unique secrets, HTTPS, Redis queue, real providers
#
# MySQL is the business source of truth. Redis is used for cache/queue/session/Horizon.
# Create DB first, then: php artisan migrate --seed
# Super admin (local only): php artisan adman:create-super-admin
# Staging: php artisan adman:create-super-admin --force-staging
# Production: do not use the Super Admin bootstrap command.
# Operator checks: php artisan adman:production-check && php artisan adman:health

APP_NAME=ADMAN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# local: debug | staging/production: info or warning
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adman
DB_USERNAME=root
DB_PASSWORD=

# Production: redis + SESSION_SECURE_COOKIE=true behind HTTPS
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Required for Horizon. Do not leave unset in production.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# local: log | staging/production: smtp/ses/postmark/etc (never log for real customers)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Org kill switch also exists in Business settings
ADMAN_EMAIL_ENABLED=true

# WhatsApp Cloud API (Meta) — never commit real secrets
# Production requires ACCESS_TOKEN, PHONE_NUMBER_ID, APP_SECRET, WEBHOOK_VERIFY_TOKEN
ADMAN_WHATSAPP_ENABLED=true
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_QUOTE=adman_quote
WHATSAPP_TEMPLATE_INVOICE=adman_invoice
WHATSAPP_TEMPLATE_INVOICE_REMINDER=adman_invoice_reminder
WHATSAPP_TEMPLATE_PAYMENT_ACK=adman_payment_ack
WHATSAPP_INBOUND_MEDIA_MAX_BYTES=15728640

# AI assistant — disabled by default; enable deliberately
# Production forbids ADMAN_AI_PROVIDER=fake (falls back to real provider / safe failure)
ADMAN_AI_ENABLED=false
ADMAN_AI_PROVIDER=openai
ADMAN_AI_API_KEY=
ADMAN_AI_BASE_URL=https://api.openai.com/v1
ADMAN_AI_MODEL=gpt-4o-mini
ADMAN_AI_TIMEOUT=45

# Optional S3 (not required for MVP single-server private disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
