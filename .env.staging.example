# ADMAN staging environment template
# Copy to the staging server as .env (never commit the real file).
# Generate: php artisan key:generate
# See technical_Docs/012-staging-deployment-and-uat.md

APP_NAME=ADMAN
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adman_staging
DB_USERNAME=adman_staging
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# Prefer a sandbox inbox / Mailtrap / SES sandbox — never production customers
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="staging@example.com"
MAIL_FROM_NAME="${APP_NAME} Staging"

ADMAN_EMAIL_ENABLED=true

# Use a dedicated Meta test app / test number. Disable until configured.
ADMAN_WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_QUOTE=adman_quote
WHATSAPP_TEMPLATE_INVOICE=adman_invoice
WHATSAPP_TEMPLATE_INVOICE_REMINDER=adman_invoice_reminder
WHATSAPP_TEMPLATE_PAYMENT_ACK=adman_payment_ack

# Keep disabled until staging API credentials exist. Never use fake when enabled.
ADMAN_AI_ENABLED=false
ADMAN_AI_PROVIDER=openai
ADMAN_AI_API_KEY=
ADMAN_AI_BASE_URL=https://api.openai.com/v1
ADMAN_AI_MODEL=gpt-4o-mini
ADMAN_AI_TIMEOUT=45

VITE_APP_NAME="${APP_NAME}"
